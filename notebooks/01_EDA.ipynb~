# -*- coding: utf-8 -*-
"""
Bootstrap data-handling for ML_EnthalpyFormation.

This cell will:
- Create a reproducible project folder under /mnt/data/ML_EnthalpyFormation
- Copy the uploaded Excel (/mnt/data/SI_review_23_12_2020.xlsx) into data/originals/ (timestamped snapshot) and data/raw/
- Generate a MANIFEST.json with checksums, sizes, and a light schema
- Normalize column names and save a first processed CSV/Parquet
- Emit a short summary table for you to review
"""

import os, shutil, hashlib, json, datetime, re
from pathlib import Path
import pandas as pd
import numpy as np

# ---------- Paths
uploaded = Path("/mnt/data/SI_review_23_12_2020.xlsx")  # from the user note
proj = Path("/mnt/data/ML_EnthalpyFormation").resolve()
data_dir = proj / "data"
raw_dir = data_dir / "raw"
orig_dir = data_dir / "originals"
proc_dir = data_dir / "processed"
results_dir = proj / "results" / "reports"
fig_dir = proj / "results" / "figures"

for d in [raw_dir, orig_dir, proc_dir, results_dir, fig_dir]:
    d.mkdir(parents=True, exist_ok=True)

# ---------- Helper: checksum
def sha256sum(path: Path, chunk_size: int = 1 << 20) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(chunk_size), b""):
            h.update(chunk)
    return h.hexdigest()

# ---------- Copy originals with snapshot
ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
orig_name = uploaded.name
snapshot_name = f"{uploaded.stem}__snapshot_{ts}{uploaded.suffix}"
dest_raw = raw_dir / orig_name
dest_snapshot = orig_dir / snapshot_name

# Copy to raw/ (current canonical copy)
shutil.copy2(uploaded, dest_raw)
# Snapshot (immutable archival copy)
shutil.copy2(uploaded, dest_snapshot)

# ---------- Build MANIFEST.json
manifest_path = proj / "MANIFEST.json"
manifest = {
    "project": "ML_EnthalpyFormation",
    "generated_at": datetime.datetime.now().isoformat(),
    "files": []
}

for p in [dest_raw, dest_snapshot]:
    manifest["files"].append({
        "relpath": str(p.relative_to(proj)),
        "size_bytes": p.stat().st_size,
        "sha256": sha256sum(p),
        "modified": datetime.datetime.fromtimestamp(p.stat().st_mtime).isoformat()
    })

# ---------- Load Excel and normalize columns (lowercase, underscores, strip symbols)
def normalize_columns(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df.columns = (
        df.columns.astype(str)
        .str.strip()
        .str.lower()
        .str.replace(r"\s+", "_", regex=True)
        .str.replace("[()]", "", regex=True)
        .str.replace(r"[^a-z0-9_]", "", regex=True)
    )
    return df

df = pd.read_excel(dest_raw, engine="openpyxl")
df_norm = normalize_columns(df)

# record a very light schema for MANIFEST
schema = {c: str(df_norm[c].dtype) for c in df_norm.columns}
manifest["schema_preview"] = schema

with open(manifest_path, "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)

# ---------- Minimal processing: coerce numeric for likely enthalpy columns and save processed CSV/Parquet
likely_y_cols = [c for c in df_norm.columns if re.search(r"(delta|dfh|hf|entalp|deltah|h298)", c)]
df_proc = df_norm.copy()
for c in likely_y_cols:
    df_proc[c] = pd.to_numeric(df_proc[c], errors="ignore")  # do not force NaN if strings are present

# Save
proc_csv = proc_dir / "SI_review_23_12_2020__clean.csv"
proc_parquet = proc_dir / "SI_review_23_12_2020__clean.parquet"
df_proc.to_csv(proc_csv, index=False)
try:
    df_proc.to_parquet(proc_parquet, index=False)
    parquet_saved = True
except Exception as e:
    parquet_saved = False
    parquet_error = str(e)

# ---------- Write a tiny README and CONFIG
readme = proj / "README.md"
if not readme.exists():
    readme.write_text(
        "# ML_EnthalpyFormation\n\n"
        "- `data/originals/`: snapshots inmutables con sello de tiempo.\n"
        "- `data/raw/`: copia canónica del Excel original (para lectura).\n"
        "- `data/processed/`: CSV/Parquet con columnas normalizadas.\n"
        "- `results/`: reportes y figuras.\n\n"
        "Manifest y esquema básico en `MANIFEST.json`.\n",
        encoding="utf-8"
    )

config = proj / "config.yaml"
if not config.exists():
    config.write_text(
        "seed: 42\n"
        "paths:\n"
        f"  excel_path: {str(dest_raw)}\n"
        "  processed_dir: data/processed\n"
        "columns_aliases:\n"
        "  id: [id, molecule_id, compound_id, name, nombre, iupac, compound]\n"
        "  smiles: [smiles, smile, can_smiles]\n"
        "  delta_h_exp_kjmol: [dfh_exp, delta_h_exp_kjmol, hf298_exp, ΔfH_exp_kJ/mol]\n"
        "  delta_h_theory_kjmol: [dfh_calc, delta_h_theory_kjmol, hf298_calc, ΔfH_calc_kJ/mol]\n",
        encoding="utf-8"
    )

# ---------- Build a small report table
from caas_jupyter_tools import display_dataframe_to_user
summary_rows = []
summary_rows.append({
    "file": str(dest_raw.relative_to(proj)),
    "role": "raw/current",
    "size_kb": round(dest_raw.stat().st_size/1024, 2),
    "sha256": sha256sum(dest_raw)[:16] + "...",
})
summary_rows.append({
    "file": str(dest_snapshot.relative_to(proj)),
    "role": "original/snapshot",
    "size_kb": round(dest_snapshot.stat().st_size/1024, 2),
    "sha256": sha256sum(dest_snapshot)[:16] + "...",
})
summary_rows.append({
    "file": str(proc_csv.relative_to(proj)),
    "role": "processed CSV",
    "size_kb": round(proc_csv.stat().st_size/1024, 2),
    "sha256": sha256sum(proc_csv)[:16] + "...",
})
if parquet_saved:
    summary_rows.append({
        "file": str(proc_parquet.relative_to(proj)),
        "role": "processed Parquet",
        "size_kb": round(proc_parquet.stat().st_size/1024, 2),
        "sha256": sha256sum(proc_parquet)[:16] + "...",
    })
else:
    summary_rows.append({
        "file": "Parquet save failed",
        "role": parquet_error,
        "size_kb": "",
        "sha256": "",
    })

summary_df = pd.DataFrame(summary_rows)
display_dataframe_to_user("Data pipeline snapshot", summary_df)

proj.as_posix(), manifest_path.as_posix(), proc_csv.as_posix(), (proc_parquet.as_posix() if parquet_saved else None)
